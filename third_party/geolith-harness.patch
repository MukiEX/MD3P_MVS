+
+/* ---- harness debug watch ---- */
+typedef struct { uint32_t pc, addr, val; uint32_t rwsize; } dbg_rec_t;
+#define DBG_N 262144
+dbg_rec_t geo_dbg_log[DBG_N];
+uint32_t geo_dbg_count = 0;
+uint32_t geo_dbg_snd[1024]; uint32_t geo_dbg_sndn = 0;
+uint16_t geo_dbg_vramaddr(void);
+typedef struct { uint32_t pc; uint16_t addr, val; } vrec_t;
+#define VN 1048576
+vrec_t geo_dbg_vlog[VN]; uint32_t geo_dbg_vn = 0, geo_dbg_von = 0;
+vrec_t *geo_dbg_vlogptr(void) { return geo_dbg_vlog; }
+uint32_t geo_dbg_vcount(void) { return geo_dbg_vn; }
+void geo_dbg_vctl(uint32_t on) { geo_dbg_von = on; geo_dbg_vn = 0; }
+uint32_t *geo_dbg_sndptr(void) { return geo_dbg_snd; }
+uint32_t geo_dbg_sndcount(void) { uint32_t n = geo_dbg_sndn; return n; }
+void geo_dbg_sndclear(void) { geo_dbg_sndn = 0; }
+uint32_t geo_dbg_lo = 0, geo_dbg_hi = 0, geo_dbg_mode = 0; /* mode bit0 = reads, bit1 = writes */
+void geo_dbg_watch(uint32_t lo, uint32_t hi, uint32_t mode) { geo_dbg_lo = lo; geo_dbg_hi = hi; geo_dbg_mode = mode; geo_dbg_count = 0; }
+dbg_rec_t *geo_dbg_logptr(void) { return geo_dbg_log; }
+uint32_t geo_dbg_get_count(void) { return geo_dbg_count; }
+static inline void dbg_acc(uint32_t a, uint32_t v, uint32_t rw, uint32_t sz) {
+    a = 0x100000 | (a & 0xffff);
+    if (a >= geo_dbg_lo && a < geo_dbg_hi && (geo_dbg_mode & (1u << rw)) && geo_dbg_count < DBG_N) {
+        dbg_rec_t *r = &geo_dbg_log[geo_dbg_count++];
+        r->pc = m68k_get_reg(NULL, M68K_REG_PPC); r->addr = a; r->val = v; r->rwsize = (rw << 8) | sz;
+    }
+}
